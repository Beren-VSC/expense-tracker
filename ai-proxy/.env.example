# คัดลอกไปเป็น .env สำหรับรัน `vercel dev` ในเครื่อง
# ห้าม commit .env จริงที่มี key ลง git
# ขอ key ฟรีได้ที่ Google AI Studio: https://aistudio.google.com/apikey (ไม่ต้องผูกบัตรเครดิต)
GEMINI_API_KEY=AIza...

# รหัสลับที่แชร์กับแอปมือถือ (ต้องตรงกับ EXPO_PUBLIC_APP_SECRET ฝั่ง expense-tracker-app/.env)
# สร้างค่าใหม่ได้ด้วย: openssl rand -hex 24
APP_SHARED_SECRET=

# Cloud sync (/api/data) — สมัครฟรีที่ https://console.upstash.com > Redis > สร้าง database > แท็บ REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
